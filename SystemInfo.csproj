<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Version>1.0.1</Version>
    <AssemblyVersion>1.0.1.0</AssemblyVersion>
    <FileVersion>1.0.1.0</FileVersion>
    <InformationalVersion>1.0.1</InformationalVersion>
    <ApplicationIcon>Assets\SystemInfo.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <UseWpf>true</UseWpf>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <!-- Ship the .ico next to the app: the tray loads it from the install folder at runtime (previously it fell back to the generic Windows icon). -->
    <Content Include="Assets\SystemInfo.ico">
      <Link>SystemInfo.ico</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- The test harness lives in a subfolder but must not compile into the app. -->
    <Compile Remove="SystemInfo.Tests\**\*.cs" />
    <None Remove="SystemInfo.Tests\**\*" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="cpu_gpu_models.json" LogicalName="SystemInfo.cpu_gpu_models.json" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <!-- match LibreHardwareMonitorLib dependency minimum -->
    <PackageReference Include="System.Management" Version="10.0.2" />
  </ItemGroup>
</Project>
