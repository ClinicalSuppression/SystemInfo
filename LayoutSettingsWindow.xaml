<Window x:Class="SystemInfo.LayoutSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Display, theme &amp; scaling" Width="420" Height="420"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource DialogBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="OK" Width="80" Margin="0,0,6,0" Click="OkButton_Click" />
            <Button Content="Cancel" Width="80" IsCancel="True" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock FontSize="13" FontWeight="SemiBold" Text="Theme" Margin="0,0,0,8" />
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock FontSize="11" VerticalAlignment="Center" Text="Mode" />
                <ComboBox x:Name="ThemeModeCombo" Grid.Column="1" Margin="0,0,0,4" />
            </Grid>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock FontSize="11" VerticalAlignment="Center" Text="Scheme" />
                <ComboBox x:Name="ThemeSchemeCombo" Grid.Column="1" />
            </Grid>
            <TextBlock FontSize="13" FontWeight="SemiBold" Text="Independent scaling (5 sizes each)" Margin="0,0,0,8" />
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock FontSize="11" VerticalAlignment="Center" Text="Font" />
                <ComboBox x:Name="FontCombo" Grid.Column="1" Margin="0,0,0,4" />
            </Grid>
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock FontSize="11" VerticalAlignment="Center" Text="Bars" />
                <ComboBox x:Name="BarCombo" Grid.Column="1" Margin="0,0,0,4" />
            </Grid>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock FontSize="11" VerticalAlignment="Center" Text="Graphs" />
                <ComboBox x:Name="GraphCombo" Grid.Column="1" />
            </Grid>
            <TextBlock FontSize="13" FontWeight="SemiBold" Text="Locks &amp; alerts" Margin="0,0,0,8" />
            <CheckBox x:Name="TopMostCheck" Content="Keep on top" Margin="0,0,0,6" />
            <CheckBox x:Name="WindowLockedCheck" Content="Lock window (move + resize)" Margin="0,0,0,6" />
            <CheckBox x:Name="BoxesLockedCheck" Content="Lock boxes (move + resize)" Margin="0,0,0,6" />
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock FontSize="11" VerticalAlignment="Center" Text="Temp alert (°C)" />
                <TextBox x:Name="TempAlertBox" Grid.Column="1" Padding="4,0,4,0" />
            </Grid>
            <CheckBox x:Name="TrayCheck" Content="Minimize to tray (start hidden)" Margin="0,6,0,0" />
            <CheckBox x:Name="StartupCheck" Content="Start with Windows" Margin="0,6,0,0" ToolTip="Registers this app under HKCU Run so it launches at logon" />
            <CheckBox x:Name="AdminCheck" Content="Start as Administrator" Margin="0,6,0,0" ToolTip="When enabled, relaunch elevated via UAC so sensors that need admin have full data" />
        </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
