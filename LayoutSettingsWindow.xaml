<Window x:Class="SystemInfo.LayoutSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="420" Height="700"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource DialogBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
    <DockPanel Margin="14">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="OK" Width="80" Margin="0,0,6,0" Click="OkButton_Click" />
            <Button Content="Cancel" Width="80" IsCancel="True" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <TextBlock FontSize="13" FontWeight="SemiBold" Text="Startup" Margin="0,0,0,8" />
            <CheckBox x:Name="TrayCheck" Content="Minimize to tray" Margin="0,0,0,6" />
            <CheckBox x:Name="StartupCheck" Content="Start with Windows" Margin="0,0,0,6" ToolTip="Registers this app under HKCU Run so it launches at logon" />
            <CheckBox x:Name="AdminCheck" Content="Start as Administrator" Margin="0,0,0,12" ToolTip="Relaunch elevated via UAC so sensors that need admin have full data" />

            <TextBlock FontSize="13" FontWeight="SemiBold" Text="Window" Margin="0,0,0,8" />
            <CheckBox x:Name="TopMostCheck" Content="Keep on top" Margin="0,0,0,6" />
            <CheckBox x:Name="WindowLockedCheck" Content="Lock window (move + resize)" Margin="0,0,0,6" />
            <CheckBox x:Name="BoxesLockedCheck" Content="Lock boxes (move + resize)" Margin="0,0,0,6" />
            <CheckBox x:Name="HideBackgroundCheck" Content="Hide background" Margin="0,0,0,6" ToolTip="Hides the window title/close/minimize chrome when the mouse is not hovering the window. Boxes remain visible." />
            <CheckBox x:Name="UpdatesCheck" Content="Check for updates on startup" Margin="0,0,0,12" ToolTip="Prompts on startup if a newer SystemInfo version is available." />

            <TextBlock FontSize="13" FontWeight="SemiBold" Text="Background image" Margin="0,0,0,8" />
            <CheckBox x:Name="BackgroundImageCheck" Content="Enable custom background image" Margin="0,0,0,6" ToolTip="When enabled, the window background uses the selected image. Boxes remain opaque on top." Click="BackgroundImageCheck_Click" />
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock FontSize="11" VerticalAlignment="Center" Text="File" />
                <TextBox x:Name="BackgroundImagePathBox" Grid.Column="1" Margin="0,0,4,0" Height="22" Padding="4,0,4,0" IsReadOnly="True" Text="(none)" VerticalContentAlignment="Center" ToolTip="Custom image path. Use Browse to choose a PNG, JPG, BMP, or WEBP image." />
                <Button x:Name="BackgroundImageBrowseButton" Grid.Column="2" Content="Browse…" Click="BackgroundImageBrowseButton_Click" />
            </Grid>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                <TextBlock FontSize="11" VerticalAlignment="Center" Text="Opacity" />
                <Slider x:Name="BackgroundOpacitySlider" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Value="100" ValueChanged="BackgroundOpacitySlider_ValueChanged" />
                <TextBlock x:Name="BackgroundOpacityValue" Grid.Column="2" FontSize="11" VerticalAlignment="Center" Text="100%" TextAlignment="Right"/>
            </Grid>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                <TextBlock FontSize="11" VerticalAlignment="Center" Text="Saturation" />
                <Slider x:Name="BackgroundSaturationSlider" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Value="100" ValueChanged="BackgroundSaturationSlider_ValueChanged" />
                <TextBlock x:Name="BackgroundSaturationValue" Grid.Column="2" FontSize="11" VerticalAlignment="Center" Text="100%" TextAlignment="Right"/>
            </Grid>
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                <TextBlock FontSize="11" VerticalAlignment="Center" Text="Brightness" />
                <Slider x:Name="BackgroundBrightnessSlider" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Value="100" ValueChanged="BackgroundBrightnessSlider_ValueChanged" />
                <TextBlock x:Name="BackgroundBrightnessValue" Grid.Column="2" FontSize="11" VerticalAlignment="Center" Text="100%" TextAlignment="Right"/>
            </Grid>
            <Border x:Name="BackgroundPreviewBorder" BorderBrush="{DynamicResource ButtonBorderBrush}" BorderThickness="1" CornerRadius="4" Height="140" Margin="0,2,0,6" Background="{DynamicResource DialogBackgroundBrush}" HorizontalAlignment="Stretch" SnapsToDevicePixels="True">
                <Viewbox HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" MaxWidth="380">
                    <Image x:Name="BackgroundPreviewImage" Stretch="Uniform" Opacity="1" />
                </Viewbox>
            </Border>
            <Button x:Name="ClearBackgroundImageButton" Content="Clear image" Click="ClearBackgroundImageButton_Click" HorizontalAlignment="Right" Margin="0,0,0,12" />

            <TextBlock FontSize="13" FontWeight="SemiBold" Text="Performance" Margin="0,0,0,8" />
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock FontSize="11" VerticalAlignment="Center" Text="Refresh" />
                <ComboBox x:Name="UpdateIntervalCombo" Grid.Column="1" />
            </Grid>

            <TextBlock FontSize="13" FontWeight="SemiBold" Text="Appearance" Margin="0,0,0,8" />
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock FontSize="11" VerticalAlignment="Center" Text="Mode" />
                <ComboBox x:Name="ThemeModeCombo" Grid.Column="1" Margin="0,0,0,4" />
            </Grid>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock FontSize="11" VerticalAlignment="Center" Text="Scheme" />
                <ComboBox x:Name="ThemeSchemeCombo" Grid.Column="1" />
            </Grid>
            <TextBlock FontSize="13" FontWeight="SemiBold" Text="Independent scaling (5 sizes each)" Margin="0,0,0,8" />
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock FontSize="11" VerticalAlignment="Center" Text="Font" />
                <ComboBox x:Name="FontCombo" Grid.Column="1" Margin="0,0,0,4" />
            </Grid>
            <Grid Margin="0,0,0,6">
                <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock FontSize="11" VerticalAlignment="Center" Text="Bars" />
                <ComboBox x:Name="BarCombo" Grid.Column="1" Margin="0,0,0,4" />
            </Grid>
            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock FontSize="11" VerticalAlignment="Center" Text="Graphs" />
                <ComboBox x:Name="GraphCombo" Grid.Column="1" />
            </Grid>

            <TextBlock FontSize="13" FontWeight="SemiBold" Text="About" Margin="0,0,0,8" />
            <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" Text="SystemInfo © ClinicalSuppression — distributable under the PolyForm Noncommercial License 1.0.0. Licenses and acknowledgements are listed in LICENSE." Margin="0,0,0,4" />
            <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" Text="Uses LibreHardwareMonitorLib 0.9.6 (MPL-2.0) by LibreHardwareMonitor Contributors." Margin="0,0,0,0" />
            <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextMutedBrush}" Text="Live hardware access uses PawnIO (namazso.PawnIO), a mandatory prerequisite for elevated sensor data." Margin="0,4,0,0" />
        </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
