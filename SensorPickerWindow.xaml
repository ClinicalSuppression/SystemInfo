<Window x:Class="SystemInfo.SensorPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sensors" Width="900" Height="620"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource DialogBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <TextBlock Text="Line:" Margin="0,0,4,0" VerticalAlignment="Center" ToolTip="Per-sensor graph line thickness" />
            <ComboBox x:Name="ThicknessBox" Width="60" Margin="0,0,12,0" ToolTip="Per-sensor graph line thickness">
                <ComboBoxItem Tag="1">1.0</ComboBoxItem>
                <ComboBoxItem Tag="1.4">1.4</ComboBoxItem>
                <ComboBoxItem Tag="2">2.0</ComboBoxItem>
                <ComboBoxItem Tag="2.6">2.6</ComboBoxItem>
            </ComboBox>
            <TextBlock Text="Scale:" Margin="0,0,4,0" VerticalAlignment="Center" />
            <ComboBox x:Name="ScaleBox" Width="70" Margin="0,0,12,0" ToolTip="Auto = history+descriptor range; Fixed = descriptor Min/Max only">
                <ComboBoxItem Tag="Auto">Auto</ComboBoxItem>
                <ComboBoxItem Tag="Fixed">Fixed</ComboBoxItem>
            </ComboBox>
            <TextBlock Text="Speed:" Margin="0,0,4,0" VerticalAlignment="Center" ToolTip="Network throughput unit" />
            <ComboBox x:Name="NetworkSpeedBox" Width="64" Margin="0,0,12,0">
                <ComboBoxItem Tag="Auto">Auto</ComboBoxItem>
                <ComboBoxItem Tag="B/s">B/s</ComboBoxItem>
                <ComboBoxItem Tag="KB/s">KB/s</ComboBoxItem>
                <ComboBoxItem Tag="MB/s">MB/s</ComboBoxItem>
                <ComboBoxItem Tag="GB/s">GB/s</ComboBoxItem>
            </ComboBox>
            <Button Content="OK" Width="80" Margin="0,0,6,0" Click="OkButton_Click" />
            <Button Content="Cancel" Width="80" IsCancel="True" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock x:Name="TitleText" FontSize="13" FontWeight="SemiBold" Text="Pick sensors" Margin="0,0,0,6" Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock x:Name="LhmText" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4" TextWrapping="Wrap" />
                <TextBlock FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4" TextWrapping="Wrap" Text="Show = row shown in box. Text is always far-right; Bar sits between name and text and every bar in the box shares one width. Graph draws directly BELOW its sensor row (height ≈ 3× text height) — no default graphs are shown. Click a colour swatch to cycle its graph line colour." />
                <TextBox x:Name="SearchBox" Margin="0,0,0,6" ToolTip="Filter sensor name or category" />
                <TextBlock FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,2" Text="Show | Text | Bar | Graph (below) | Colour  —  Name [Unit]   Live LHM value" />
                <StackPanel x:Name="ListPanel" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
